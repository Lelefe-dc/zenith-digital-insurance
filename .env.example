ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/zenith.db
MAX_UPLOAD_MB=8
UPLOAD_DIR=./data/uploads

# Docker Compose host ports
FRONTEND_PORT=3201
BACKEND_PORT=8201

# Management bootstrap account - change both before shared use
MANAGEMENT_ADMIN_EMAIL=admin@zenith.local
MANAGEMENT_ADMIN_PASSWORD=change-me-now
MANAGEMENT_SESSION_HOURS=12

# Docker Compose PostgreSQL settings
POSTGRES_DB=zenith_assistant
POSTGRES_USER=zenith
POSTGRES_PASSWORD=zenith_dev_password

# WhatsApp phase is intentionally deferred until the management system is complete.
# Keep these blank until the final integration phase.
WHATSAPP_VERIFY_TOKEN=replace-with-random-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# Turn on only after a real OTP provider is integrated.
REQUIRE_POLICY_OTP=false
